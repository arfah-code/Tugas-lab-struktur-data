//array 3d diisi angka kelipatan 2, ditampilkan dalam bentuk 3 lapis tabel
#include <iostream>
using namespace std;

int main(){
    int nilai[3][3][4];
    int angka = 2;

    for(int i=0; i<3; i++){
        for(int j=0; j<3; j++){
            for(int k=0; k<4; k++){
                nilai[i][j][k] = angka;
                angka = angka + 2;
            }
        }
    }

    for(int i=0; i<3; i++){
        for(int j=0; j<3; j++){
            for(int k=0; k<4; k++){
                cout << nilai[i][j][k] << " ";
            }
            cout << endl;
        }
        cout << endl;
    }

    return 0;
}
